# Copy this file to `.env` and fill in real values. `.env` is gitignored and must never be committed.

# SEC EDGAR fair-access policy: every request must identify the requester with a real name and
# contact email. Format: "Your Name your-email@example.com"
SEC_EDGAR_USER_AGENT="Your Name your-email@example.com"

# Free FRED API key: https://fred.stlouisfed.org/docs/api/api_key.html
# Only needed for the later macro-data phase. Leave empty until then.
FRED_API_KEY="your_fred_api_key_here"
